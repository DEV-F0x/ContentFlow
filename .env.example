# Copy this file to .env and fill in the blanks -- .env is gitignored and
# read automatically by docker compose (env_file: .env) and by both services
# (python-dotenv). See README.md for the full explanation of every var below.
#
# Generate random secrets with, e.g.: openssl rand -base64 24

# --- Backend toggles ---
# STORAGE_BACKEND: "s3" (MinIO/S3) or "local" (Docker bind mount, see
# LOCAL_STORAGE_PATH below). DB_BACKEND: "postgres" or "sqlite" (a single
# file, see SQLITE_PATH below). Toggle each independently.
STORAGE_BACKEND=local
DB_BACKEND=sqlite

# Compose profiles to actually start: include "s3" iff STORAGE_BACKEND=s3,
# include "postgres" iff DB_BACKEND=postgres. Read automatically by
# `docker compose` from this file -- keep it in sync with the two toggles
# above. E.g. STORAGE_BACKEND=local + DB_BACKEND=sqlite -> COMPOSE_PROFILES=
COMPOSE_PROFILES=

# --- Local filesystem storage (used when STORAGE_BACKEND=local) ---
# Bind-mounted to ./data/storage on the host by docker-compose.yml.
LOCAL_STORAGE_PATH=./data/storage

# --- SQLite (used when DB_BACKEND=sqlite) ---
# Bind-mounted to ./data on the host by docker-compose.yml.
SQLITE_PATH=./data/dashboard.db

# --- Postgres (asset metadata; used when DB_BACKEND=postgres) ---
POSTGRES_USER=contentflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=contentflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- MinIO (S3-compatible object storage; used when STORAGE_BACKEND=s3) ---
# In prod, point S3_ENDPOINT_URL at real S3 / R2 / multi-region MinIO cluster
# without touching app code.
MINIO_ROOT_USER=contentflow
MINIO_ROOT_PASSWORD=changeme
S3_ENDPOINT_URL=http://minio:9000
# Informational only -- not read by either service. Handy if you need the
# browser-reachable address of the same bucket (e.g. the MinIO console).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Dev: same as MinIO root creds, so no separate IAM user needs provisioning.
# In prod, swap for a scoped access key / real S3 credentials.
S3_ACCESS_KEY=contentflow
S3_SECRET_KEY=changeme
S3_BUCKET=contentflow-assets
S3_REGION=us-east-1

# --- API service (read-only file server; dashboard builds links to it) ---
API_PUBLIC_URL=http://localhost:5000

# --- Dashboard service ---
DASHBOARD_SECRET_KEY=changeme
FLASK_DEBUG=0

# Bearer token for the machine-oriented JSON API under /api/v1 (used by
# e.g. the Terraform provider in terraform-provider-contentflow/). Leave
# unset to keep that API disabled entirely. Generate with, e.g.:
# openssl rand -base64 32
# DASHBOARD_API_TOKEN=

# --- Dashboard login ---
# Single admin identity, configured entirely here -- no accounts table, no
# database row, login is just a string comparison against these two values.
# Either or both login methods may be enabled. AUTH_BASIC_ENABLED checks
# username+password against ADMIN_USERNAME/ADMIN_PASSWORD directly.
AUTH_BASIC_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# AUTH_OAUTH_ENABLED is a generic OAuth2 client: works with any provider
# that exposes authorize/token/userinfo endpoints (Okta, Auth0, Keycloak,
# Google, Authentik, etc) -- it only accepts a login whose returned email
# matches ADMIN_USERNAME, so only enable it if you set ADMIN_USERNAME to
# that same email address. Leave disabled unless you have a provider ready.
AUTH_OAUTH_ENABLED=false
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_AUTHORIZE_URL=https://your-provider.example.com/application/o/authorize/
# OAUTH_TOKEN_URL=https://your-provider.example.com/application/o/token/
# OAUTH_USERINFO_URL=https://your-provider.example.com/application/o/userinfo/
# Required whenever OAUTH_SCOPE includes "openid" (the default) -- the
# provider then returns a signed id_token that Authlib verifies against
# this JWKS endpoint automatically.
# OAUTH_JWKS_URL=https://your-provider.example.com/application/o/<app-slug>/jwks/
# OAUTH_SCOPE=openid email profile
# OAUTH_EMAIL_FIELD=email
# true: any account that can authenticate against the OAuth provider above
# gets in, regardless of ADMIN_USERNAME (access control lives entirely with
# the provider, e.g. who's assigned to the application there).
# OAUTH_ALLOW_SIGNUP=false
